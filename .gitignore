.env*
logs/*
!logs/.gitkeep
*.db
.codegraph
__pycache__/
*.pyc
.venv/
node_modules/

# pytest / ruff caches (root and configs/rag/*). Each tool drops its own `*` .gitignore
# inside the directory; listing them here makes the exclusion ours, not the tool's courtesy.
.pytest_cache/
.ruff_cache/

# Agent run-state — ephemeral harness files, rewritten every turn and read by no check.
# Plans / evidence / notepads / ulw-* ledgers under .omo/ are tracked explicitly for history.
#   run-continuation/  session continuation files (rule since 2026-07-18; the 89 entries
#                      committed before it stayed in the index until 2026-09-14)
#   senpi-task/        child-task transcripts + mass-ulw DAG state — local_ci.sh and
#                      release.sh already exclude it from the dirty-tree check; 98 entries
#                      untracked 2026-09-14
#   thread-tools/      team mailbox / receipts / locks
.omo/run-continuation/
.omo/boulder.json
.omo/senpi-task/
.omo/thread-tools/

# Browser-tool residue — Playwright MCP drops page snapshots / console logs here
# while reviewing local pages. Machine dumps of files already tracked, not source.
/.playwright-mcp/

# mail-mode: tracked seed = configs/mail-mode.default.json; the old live path is
# runtime-only residue and must never re-enter the index. .repair-plans/ = prod runtime state.
/configs/mail-mode.json
/configs/peers.yaml
/.repair-plans/

# patent-prep backup: real invention material / ciphertext must never enter the repo.
# Authoritative drafts live in ~/patent-drafts outside the checkout; these guard stray copies.
*.age
skills/patent-prep/**/draft.md
tests/fixtures/patent-export/*.md
!tests/fixtures/patent-export/synthetic_*.md
