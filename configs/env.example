# Repository-wide environment template. Copy only the entries needed by enabled services.
# This file is a tracked seed; keep runtime values outside the checkout.
# Vendored mail client variables are out of scope; see skills/mail/vendor/mailon/config.py.

# Shared runtime, identity, and approval settings
# Owner identity used by owner-gated automation.
AUTOPHAGY_OWNER_ID=<your-discord-user-id>
# Repository checkout used by skill wrappers and no-agent watchers.
AUTOPHAGY_REPO_ROOT=<path-to-autophagy-checkout>
# Root directory for the installed automation runtime.
AUTOPHAGY_RUNTIME_ROOT=<path-to-autophagy-runtime>
# Group roster file declaring the admin whose managed-skill releases are trusted.
AUTOPHAGY_ROSTER=<path-to-group-roster>
# Process home directory inherited by wrappers.
HOME=<your-home-directory>
# Executable search path inherited by subprocesses.
PATH=<system-executable-path>
# User identity supplied by privileged deployment commands.
SUDO_USER=<privileged-user-name>
# Common Discord credential for enabled automation and skills.
DISCORD_BOT_TOKEN=<your-discord-bot-token>
# Common LiteLLM-compatible API credential.
LITELLM_AGENT_KEY=<your-litellm-api-key>
# Common LiteLLM-compatible base endpoint.
LITELLM_BASE_URL=<your-litellm-base-url>
# Shared interop configuration file.
INTEROP_CONFIG=<path-to-interop-config>
# Shared interop runtime state directory.
INTEROP_RUNTIME=<path-to-interop-runtime>
# Interop sender bot identity for live peer tests.
INTEROP_AGENT_BOT_ID=<interop-agent-bot-id>
# Test-only interop signing secret.
INTEROP_E2E_SECRET=<test-only-secret>
# Test-only interop plugin path.
INTEROP_PLUGIN_PATH=<path-to-test-plugin>
# Enable isolated end-to-end behavior only in tests.
E2E_TEST_MODE=<test-only-flag>

# Shared approval and external-effect gates
# Skill deployment approval audit log.
APPROVAL_LOG_PATH=<path-to-approval-log>
# External-effect approval audit log.
EXTERNAL_EFFECT_APPROVAL_LOG=<path-to-external-effect-approval-log>
# External-effect denylist policy file.
EXTERNAL_EFFECT_DENYLIST_PATH=<path-to-external-effect-denylist>
# Override for Obsidian write denylist policy.
OBSIDIAN_WRITE_DENYLIST=<path-to-obsidian-write-denylist>
# Obsidian write runtime configuration file.
OBSIDIAN_WRITE_CONFIG=<path-to-obsidian-write-config>

# Calendar and coordination skill settings
# Calendar confirmation gate directory.
CALENDAR_GATE_DIR=<path-to-calendar-gate>
# Calendar approval audit log.
CALENDAR_APPROVAL_LOG=<path-to-calendar-approval-log>
# Calendar command-line client override.
CALENDAR_GWS_BIN=<calendar-client-command>
# Calendar owner agent identity used for routing.
CALENDAR_OWNER_AGENT_ID=<calendar-owner-agent-id>
# Calendar peer registry seed.
CALENDAR_PEERS_CONFIG=<path-to-calendar-peers-config>
# Calendar pending confirmation storage override.
CALENDAR_PENDING_CONFIRMS=<path-to-calendar-pending-confirms>
# Installed calendar scripts directory for reaction watcher.
CALENDAR_SCRIPTS=<path-to-calendar-scripts>
# Coordination pending confirmation storage override.
COORDINATION_PENDING_CONFIRMS=<path-to-coordination-pending-confirms>
# Installed coordination scripts directory for reaction watcher.
COORDINATION_SCRIPTS=<path-to-coordination-scripts>
# Coordination team channel identifier override.
COORD_TEAM_CHANNEL_ID=<coordination-team-channel-id>
# Coordination interop channel identifier override.
COORD_INTEROP_CHANNEL_ID=<coordination-interop-channel-id>

# Budget and task skill settings
# Budget confirmation gate directory.
BUDGET_GATE_DIR=<path-to-budget-gate>
# Budget approval audit log.
BUDGET_APPROVAL_LOG=<path-to-budget-approval-log>
