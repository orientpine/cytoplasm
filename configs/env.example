# Repository-wide environment template. Copy only the entries needed by enabled services.
# This file is a tracked seed; keep runtime values outside the checkout.
# Vendored mail client variables are out of scope; see skills/mail/vendor/mailon/config.py.

# Shared runtime, identity, and approval settings
# Owner identity used by owner-gated automation.
AUTOPHAGY_OWNER_ID=<your-discord-user-id>
# Repository checkout used by skill wrappers and no-agent watchers.
AUTOPHAGY_REPO_ROOT=<path-to-autophagy-checkout>
# Root directory for the installed automation runtime.
AUTOPHAGY_RUNTIME_ROOT=<path-to-autophagy-runtime>
# Group roster file declaring the admin whose managed-skill releases are trusted.
AUTOPHAGY_ROSTER=<path-to-group-roster>
# Process home directory inherited by wrappers.
HOME=<your-home-directory>
# Executable search path inherited by subprocesses.
PATH=<system-executable-path>
# User identity supplied by privileged deployment commands.
SUDO_USER=<privileged-user-name>
# Sandbox/E2E dummy secret sentinel; DUMMY- prefixed values switch result notices to NOTIFY-SKIP.
AUTOPHAGY_DEMO_SECRET=<dummy-sandbox-secret>
# Common Discord credential for enabled automation and skills.
DISCORD_BOT_TOKEN=<your-discord-bot-token>
# Shared interop configuration file.
INTEROP_CONFIG=<path-to-interop-config>
# Shared interop runtime state directory.
INTEROP_RUNTIME=<path-to-interop-runtime>
# Interop sender bot identity for live peer tests.
INTEROP_AGENT_BOT_ID=<interop-agent-bot-id>
# Test-only interop signing secret.
INTEROP_E2E_SECRET=<test-only-secret>
# Test-only interop plugin path.
INTEROP_PLUGIN_PATH=<path-to-test-plugin>
# Enable isolated end-to-end behavior only in tests.
E2E_TEST_MODE=<test-only-flag>

# Shared approval and external-effect gates
# Skill deployment approval audit log.
APPROVAL_LOG_PATH=<path-to-approval-log>
# External-effect approval audit log.
EXTERNAL_EFFECT_APPROVAL_LOG=<path-to-external-effect-approval-log>
# External-effect denylist policy file.
EXTERNAL_EFFECT_DENYLIST_PATH=<path-to-external-effect-denylist>
# Override for Obsidian write denylist policy.
OBSIDIAN_WRITE_DENYLIST=<path-to-obsidian-write-denylist>
# Obsidian write runtime configuration file.
OBSIDIAN_WRITE_CONFIG=<path-to-obsidian-write-config>
# Fetch/clone timeout in seconds for the Obsidian write clone (other git calls keep 120 s).
OBSIDIAN_WRITE_FETCH_TIMEOUT=900
# Override for the ~/.hermes state root used by pipeline locks and the self-skill audit local log.
HERMES_STATE_ROOT=<path-to-hermes-state-root>

# Calendar and coordination skill settings
# Calendar confirmation gate directory.
CALENDAR_GATE_DIR=<path-to-calendar-gate>
# Calendar approval audit log.
CALENDAR_APPROVAL_LOG=<path-to-calendar-approval-log>
# Calendar command-line client override.
CALENDAR_GWS_BIN=<calendar-client-command>
# Calendar owner agent identity used for routing.
CALENDAR_OWNER_AGENT_ID=<calendar-owner-agent-id>
# Calendar peer registry seed.
CALENDAR_PEERS_CONFIG=<path-to-calendar-peers-config>
# Calendar pending confirmation storage override.
CALENDAR_PENDING_CONFIRMS=<path-to-calendar-pending-confirms>
# Installed calendar scripts directory for reaction watcher.
CALENDAR_SCRIPTS=<path-to-calendar-scripts>
# Watcher consecutive-failure state root (tests/second accounts redirect it here).
WATCH_FAILURE_ROOT=<path-to-watch-failure-state>
# Coordination pending confirmation storage override.
COORDINATION_PENDING_CONFIRMS=<path-to-coordination-pending-confirms>
# Installed coordination scripts directory for reaction watcher.
COORDINATION_SCRIPTS=<path-to-coordination-scripts>
# Coordination team channel identifier override.
COORD_TEAM_CHANNEL_ID=<coordination-team-channel-id>
# Coordination interop channel identifier override.
COORD_INTEROP_CHANNEL_ID=<coordination-interop-channel-id>

# Budget and task skill settings
# Budget confirmation gate directory.
BUDGET_GATE_DIR=<path-to-budget-gate>
# Budget approval audit log.
BUDGET_APPROVAL_LOG=<path-to-budget-approval-log>
# Budget configuration file.
BUDGET_CONFIG=<path-to-budget-config>
# Budget local database.
BUDGET_DB=<path-to-budget-database>
# Budget sheet identifier.
BUDGET_SHEET_ID=<budget-sheet-id>
# Budget project-by-year sheet registry (default: ~/.hermes/budget/sheets.json).
BUDGET_SHEETS_FILE=<path-to-budget-sheets-registry>
# Test fixture replacing the budget sheet.
BUDGET_SHEET_FILE=<path-to-budget-sheet-fixture>
# Budget command-line client override.
BUDGET_GWS_BIN=<budget-client-command>
# Budget mounted scripts override for the no-agent watcher.
BUDGET_SCRIPTS=<path-to-budget-scripts>
# Todo approval audit log.
TODO_APPROVAL_LOG=<path-to-todo-approval-log>
# Todo pending/archive/claim state root.
TODO_APPROVAL_ROOT=<path-to-todo-approval-state-root>
# Todo external-effect denylist override.
TODO_DENYLIST=<path-to-todo-denylist>
# Todo command-line client override.
TODO_GWS_BIN=<todo-client-command>
# Todo owner identity override.
TODO_OWNER_ID=<todo-owner-id>
# Todo mounted scripts override for no-agent watcher tests.
TODO_SCRIPTS=<path-to-todo-scripts>

# Document, prompt, report, and proposal skill settings
# Doctype repository root.
DOCTYPE_REPO_ROOT=<path-to-doctype-repository>
# Doctype overlay entry storage.
DOCTYPE_OVERLAY_ROOT=<path-to-doctype-overlay>
# Doctype private data root.
DOCTYPE_PRIVATE_ROOT=<path-to-doctype-private-data>
# Doctype sensitivity rules file.
DOCTYPE_RULES_FILE=<path-to-doctype-rules>
# Drive client override preferred by the shared publishing facade.
DRIVE_GWS_BIN=<drive-client-command>
# Doctype owner-DM target identifier.
DOCTYPE_DM_TARGET=<doctype-owner-dm-target>
# Disable doctype owner-DM delivery when set to one.
DOCTYPE_DM_DISABLED=<disabled-flag>
# Doctype owner-DM Hermes binary override.
DOCTYPE_DM_HERMES_BIN=<hermes-command>
# Doctype LLM request log.
DOCTYPE_LLM_LOG=<path-to-doctype-llm-log>
# Doctype Hermes binary override.
DOCTYPE_HERMES_BIN=<hermes-command>
# Prompt repository root.
PROMPT_REPO_ROOT=<path-to-prompt-repository>
# Prompt overlay entry storage.
PROMPT_OVERLAY_ROOT=<path-to-prompt-overlay>
# Prompt private data root.
PROMPT_PRIVATE_ROOT=<path-to-prompt-private-data>
# Prompt sensitivity rules file.
PROMPT_RULES_FILE=<path-to-prompt-rules>
# Report sensitivity rules file.
REPORT_RULES_PATH=<path-to-report-rules>
# Report LLM run identifier.
REPORT_RUN_ID=<report-run-id>
# Report mounted scripts override for the notes no-agent wrapper.
REPORT_SCRIPTS=<path-to-report-scripts>
# Notes organizer delivered-week runtime state directory.
NOTES_ORGANIZE_STATE_DIR=<path-to-notes-organize-state>
# Proposal owner-DM target identifier.
PROPOSAL_DM_TARGET=<proposal-owner-dm-target>
# Disable proposal owner-DM delivery when set to one.
PROPOSAL_DM_DISABLED=<disabled-flag>
# Disable proposal Kanban integration when set to one.
PROPOSAL_KANBAN_DISABLED=<disabled-flag>
# Proposal LLM request log directory.
PROPOSAL_LLM_LOG_ROOT=<path-to-proposal-llm-log-directory>
# Proposal LLM run identifier.
PROPOSAL_RUN_ID=<proposal-run-id>
# Proposal workspace root.
PROPOSAL_WORKSPACE_ROOT=<path-to-proposal-workspace>
# Proposal status storage root.
PROPOSAL_STATUS_ROOT=<path-to-proposal-status>
# Proposal sensitivity rules file.
PROPOSAL_RULES_PATH=<path-to-proposal-rules>
# Pinned kimm-docbot engine revision required by proposal rendering.
PROPOSAL_DOCBOT_PIN=382f1a60a49a0f2f2e6abe21dcced9b6c011358b
# Proposal version-store root used by every v2 stage (default: ~/proposals).
PROPOSAL_ROOT=~/proposals
# Proposal image-spend and runtime state root (default: ~/.hermes/proposal).
PROPOSAL_STATE_ROOT=~/.hermes/proposal
# Offline knowledge fixture used by the proposal research stage (default: disabled).
KNOWLEDGE_FAKE_PACK=
# Proposal research transport used by the research stage (default: live; tests use fake).
PROPOSAL_RESEARCH_TRANSPORT=live
# Proposal image transport used by the image stage: fake|live|codex (default: live).
PROPOSAL_IMAGE_TRANSPORT=live
# Name of the credential variable read by the live image stage (default: OPENAI_API_KEY).
PROPOSAL_IMAGE_API_KEY_ENV=OPENAI_API_KEY
# Codex CLI command driving the codex image transport, which needs no API key (default: codex).
PROPOSAL_IMAGE_CODEX_BIN=codex
# Image quality requested by the codex image transport: low|medium|high|auto (default: medium).
PROPOSAL_IMAGE_QUALITY=medium
# Codex CLI home holding the OAuth session and its generated-image gallery (default: ~/.codex).
CODEX_HOME=~/.codex
# Browser binary the proposal visual review hands to the engine preview (default: unset — the engine resolves KIMM_DOCBOT_CHROME or a PATH candidate).
PROPOSAL_PREVIEW_CHROME=
# Image model used by the image stage (default: gpt-image-2).
PROPOSAL_IMAGE_MODEL=gpt-image-2
# Image dimensions used by the image stage (default: 1024x1024).
PROPOSAL_IMAGE_SIZE=1024x1024
# Per-request image timeout in seconds (default: 180).
PROPOSAL_IMAGE_TIMEOUT_SECONDS=180
# Monthly image-spend ceiling in USD (default: 10).
PROPOSAL_IMAGE_MONTHLY_CAP_USD=10
# Proposal refinement transport (default: live; tests use fake).
PROPOSAL_REFINE_TRANSPORT=live
# Proposal refinement host descriptor (default: codex-oauth).
PROPOSAL_REFINE_HOST=codex-oauth
# Owner-controlled hosts accepted by the proposal route guard (default: built-in list).
PROPOSAL_REFINE_ALLOWED_HOSTS=codex,codex-oauth,openai-codex,hermes-codex
# Proposal refinement timeout in seconds (default: 600).
PROPOSAL_REFINE_TIMEOUT_SECONDS=600
# Deterministic refinement behavior used only by the fake stage (default: identity).
PROPOSAL_REFINE_FAKE_MODE=identity
# Proposal publish transport (default: live; tests and scenarios use fake).
DRIVE_TRANSPORT=live
# Proposal publish Drive folder cache (default: ~/.hermes/proposal/drive-folders.json).
PROPOSAL_PUBLISH_DRIVE_CACHE=~/.hermes/proposal/drive-folders.json
# Fake proposal publish failure injection (default: disabled).
PROPOSAL_PUBLISH_FAKE_FAIL=

# Drive publishing shared by output-producing skills (see docs/guide/drive-publish.md)
# Fallback Drive client override used when DRIVE_GWS_BIN is unset.
DRIVE_PUBLISH_GWS_BIN=<drive-client-command>
# Single root folder holding every published output (default: Autophagy 산출물).
DRIVE_OUTPUTS_ROOT=<drive-output-root>
# Drive folder id lookup cache (default: ~/.hermes/drive-publish/folders.json).
DRIVE_PUBLISH_CACHE=<path-to-drive-publish-cache>
# Enable Drive publishing only when set to one.
DRIVE_PUBLISH_ENABLED=<enabled-flag>
OWNER_NOTICE_CHANNEL_ID=<owner-notifications-channel-id>

