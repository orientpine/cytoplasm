# Speech-to-text transcription settings (speechtotext skill)
# Transcription API credential; also read by the Drive watcher's child process.
OPENAI_API_KEY=<openai-api-key>
# Transcription backend: auto (local when available), local (never falls back), or api.
SPEECHTOTEXT_BACKEND=<auto-local-or-api>
# OpenAI-compatible transcription endpoint base url.
SPEECHTOTEXT_BASE_URL=<transcription-base-url>
# Transcription model served by that endpoint.
SPEECHTOTEXT_MODEL=<transcription-model>
# Spoken-language hint passed to the transcriber.
SPEECHTOTEXT_LANGUAGE=<language-code>
# Proper-noun hint prepended to each transcription request.
SPEECHTOTEXT_PROMPT=<transcription-prompt>
# meeting CLI invoked as the child that turns a transcript into minutes.
SPEECHTOTEXT_MEETING_CLI=<path-to-meeting-cli>
# Mounted speechtotext scripts directory used by the Drive watcher.
SPEECHTOTEXT_SCRIPTS=<path-to-speechtotext-scripts>
# speechtotext CLI invoked by the Drive watcher.
SPEECHTOTEXT_CLI=<path-to-speechtotext-cli>
# Directory holding the canonical markdown transcripts.
SPEECHTOTEXT_TRANSCRIPT_DIR=<path-to-transcripts>
# Watched Drive folder path; unset means the watcher does nothing.
SPEECHTOTEXT_DRIVE_FOLDER=<drive-folder-path>
# Processed-recording state file for the Drive watcher.
SPEECHTOTEXT_STATE_FILE=<path-to-speechtotext-state>
# whisper.cpp binary used for local transcription.
SPEECHTOTEXT_WHISPER_BIN=<path-to-whisper-cli>
# ggml model file used for local transcription.
SPEECHTOTEXT_WHISPER_MODEL=<path-to-ggml-model>
# Decoding thread count for local transcription.
SPEECHTOTEXT_WHISPER_THREADS=<thread-count>
# Wall-clock ceiling in seconds for one local transcription.
SPEECHTOTEXT_LOCAL_TIMEOUT=<timeout-seconds>
# Accept a transcript whose coverage check flagged a gap when set to one.
SPEECHTOTEXT_ALLOW_INCOMPLETE=<allow-incomplete-flag>
# ffmpeg binary used to normalise audio and cut upload windows.
SPEECHTOTEXT_FFMPEG_BIN=<path-to-ffmpeg>
# ffprobe binary used to read the true media duration.
SPEECHTOTEXT_FFPROBE_BIN=<path-to-ffprobe>

# Plaud lifelog sync watcher settings
# Plaud cloud poll interval in seconds (default 1800).
PLAUD_SYNC_POLL_SECONDS=<poll-seconds>
# Discovery lookback window in days (default 14).
PLAUD_SYNC_LOOKBACK_DAYS=<lookback-days>
# Max approval cards posted per watcher tick (default 3).
PLAUD_SYNC_MAX_POSTS=<max-posts>
# Local transcription of recording audio on the node (default 1; 0 = plan notes from the Plaud cloud transcript directly).
PLAUD_SYNC_TRANSCRIBE=<1-or-0>
# Recordings transcribed per watcher tick (default 1 — each run can take tens of minutes).
PLAUD_SYNC_TRANSCRIBE_PER_TICK=<per-tick>
# Recording-level failures before falling back to the cloud transcript (default 2; node failures never count).
PLAUD_SYNC_TRANSCRIBE_ATTEMPTS=<attempts>
# Seconds allowed for one speechtotext CLI run (default 21600).
PLAUD_SYNC_TRANSCRIBE_TIMEOUT=<timeout-seconds>
# Size cap for one downloaded recording in bytes (default 1073741824).
PLAUD_SYNC_MAX_AUDIO_BYTES=<max-audio-bytes>
