
[Unit]
Description=Autophagy report hub collector (W3-4, #agents-log -> SQLite)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$NODE_OPS_HOME/report-hub
Environment=PYTHONPATH=$NODE_OPS_HOME/report-hub
EnvironmentFile=$NODE_OPS_HOME/.env.secrets
EnvironmentFile=$NODE_OPS_HOME/report-hub/hub.env
ExecStart=/usr/bin/python3 -m automation.report_hub.collector
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
